# Godot 4 generated cache/config
.godot/
*.import

# Test artifacts
sim_results/
DeckLab/results/
.gut_editor_config.json
user://

# OS noise
.DS_Store
Thumbs.db
assets/original
assets/cardart

# Card packs (tools/build_card_packs.py --out packs): Scryfall art, never
# committed. The default output is the sibling ../shandalar-packs/.
packs/

# Export presets name an export TEMPLATE by absolute path, because the
# installed templates are 4.7.stable while the pinned engine is 4.7.2 —
# so the preset is machine-specific by nature. Copy the example, put your
# own path in it, and keep it out of the history.
export_presets.cfg

# Python bytecode. The tools are run from the repo (the test suite, the
# importer, the catalogue), so every run used to rewrite files that were
# once committed by mistake and leave the working tree dirty — which cost
# a scan of `git status` on every commit for weeks. Untracked 2026-09-09.
__pycache__/
*.pyc

# The MCP server's workspace (tools/shandalar_mcp.py, 2026-09-27): the
# decks and runs a client makes through the server go here by default
# — a client's own work, never the repository's.
workspace/
