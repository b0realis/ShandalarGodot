; Export presets — see docs/CODE_MAP.md and the "Release build" section of
; CONTRIBUTING.md. The pinned engine is ../tools/godot (4.7.2); the export
; templates on this machine are the 4.7.stable set, so the preset names
; both Linux templates by path instead of relying on the version folder
; Godot would look for (4.7.2.stable, which does not exist here).
;
; THE LINUX BUILD IS EXPORTED WITH THE DEBUG TEMPLATE (2026-09-08):
; build_release.sh passes --export-debug for this preset because the
; optimized template prints two "Attempt to disconnect a nonexistent
; connection" errors on every popup close (Godot #87626, embedded
; popups, open since 4.2) and the whole pile again at quit; the debug
; template prints none, looks and plays the same. So custom_template/
; debug must be set too. debug/export_console_wrapper is 0 so the
; debug export does not add a Shandalar.sh beside the binary (run.sh
; is the launcher the package ships). The web preset stays on the
; release template — a browser build never leaves embedding and never
; prints the lines. To go back to the optimized Linux binary (it is
; the faster one; the lines come back with it) nothing here changes:
; `LINUX_TEMPLATE=release ./build_release.sh …` — both template paths
; stay set. Not taken as of 2026-09-08; native popups (embed_subwindows
; off) are ruled out, the game's windows look right as they are.
;
; Excluded from the .pck: tests/, tools/, docs/, the addons and ALL of
; assets/ — and the run folders, DeckLab/results/ and the MCP server's
; workspace/ (2026-10-03): the `*.txt`/`*.deck` include below packed every
; Deck Lab report and every mined deck kept there, a report's "next:"
; line naming a deck under the builder's home folder. (A Lab or AutoDeck
; --out folder elsewhere in the checkout carries a .gdignore, which the
; exporter skips like the importer does.) Nothing under game/, engine/ or cards/ references the first
; four at runtime (checked 2026-09-02) — they exist for the suite and the
; editor only. assets/ is excluded on purpose: `game/skin.gd` loads the
; original graphics and the card art through Image.load_from_file from
; `user://original_skin` (or `res://assets/original` in a dev checkout),
; never through the import pipeline, so shipping them in the .pck would
; be dead weight — and the original art is the player's own copy of the
; 1997 game, which this project never redistributes (GameSkin's class doc).
;
; Included by hand: `*.deck` (the 317 shipped decks — DeckStore lists
; `res://decks` at runtime) and `*.txt` (`cards/data/dck_ids.txt`). Godot
; treats neither extension as a resource, so without this line the
; exported game has no decks at all. The JSON includes retain the trusted
; set catalogs and numbered-pack manifests/checklists used to validate
; external ZIPs. Pack artwork and ZIPs themselves remain outside exports.
;
; THE WEB PRESET (2026-09-07, "play via mobiles/tablets"): the same pack
; wrapped by the `web_nothreads` template. NO THREADS on purpose — the
; threaded template needs SharedArrayBuffer, which a browser only grants
; a page served with COOP/COEP headers, and static hosting (a GitHub
; Pages folder, an itch.io upload, a plain `python -m http.server`)
; sends none; the game itself starts no thread while it plays (the
; WorkerThreadPool user is the headless Deck Lab). Canvas resize policy
; 2 (adaptive) fills the browser window and the `canvas_items`/`expand`
; stretch fits the 1280x800 table to it; the canvas takes focus on start
; so the first tap is the game's; the experimental virtual keyboard is
; ON because the template only ever builds it where `ontouchstart` is
; in the window — a desktop browser never sees it, a tablet gets one for
; the deck's name. No PWA: a service worker caches the whole pack and
; the owner rebuilds often. The web build draws the clean built-in skin
; and no card art: `user://` in a browser is an empty IndexedDB and
; there is no folder beside the executable (GameSkin.portable_dir) —
; hosting the 1997 graphics online is the owner's call, not a preset's.

[preset.0]

name="Linux 64"
platform="Linux"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter="*.deck, *.txt, cards/data/*.json, packaging/card_packs/*/*.json"
exclude_filter="tests/*, tools/*, docs/*, addons/*, assets/*, sim_results/*, *.md, DeckLab/results/*, workspace/*"
export_path="../shandalar-build/linux64/Shandalar.x86_64"
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

custom_template/debug="<YOUR HOME>/.local/share/godot/export_templates/4.7.stable/linux_debug.x86_64"
custom_template/release="<YOUR HOME>/.local/share/godot/export_templates/4.7.stable/linux_release.x86_64"
debug/export_console_wrapper=0
binary_format/embed_pck=false
texture_format/s3tc_bptc=true
texture_format/etc2_astc=false
binary_format/architecture="x86_64"
ssh_remote_deploy/enabled=false
ssh_remote_deploy/host="user@host_ip"
ssh_remote_deploy/port="22"
ssh_remote_deploy/extra_args_ssh=""
ssh_remote_deploy/extra_args_scp=""
ssh_remote_deploy/run_script="#!/usr/bin/env bash
export DISPLAY=:0
unzip -o -q \"{temp_dir}/{archive_name}\" -d \"{temp_dir}\"
\"{temp_dir}/{exe_name}\" {cmd_args}"
ssh_remote_deploy/cleanup_script="#!/usr/bin/env bash
kill $(pgrep -x -f \"{temp_dir}/{exe_name} {cmd_args}\")
rm -rf \"{temp_dir}\""

