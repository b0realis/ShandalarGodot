; ANDROID / META QUEST (2026-09-29): a flat 2D panel app, sideloaded over
; adb — never the Horizon Store. The prebuilt 4.7.stable template APKs are
; named by path for the same reason the Linux ones are. The release key
; is NOT here: build_release.sh --quest sources QUEST_KEY_ENV (default
; ../shandalar-build/keys/release.env:
; GODOT_ANDROID_KEYSTORE_RELEASE_PATH/_USER/_PASSWORD) and the editor
; settings name the JDK 17 and the Android SDK under ~/.local/opt. No
; gradle build: no plugins, no XR mode, one arm64 APK. version/name is
; left empty so the APK carries application/config/version. INTERNET (and
; the network/Wi-Fi state reads) are asked for (2026-10-03): SGManalink's
; LAN host, join, discovery and tournaments open sockets, which Android
; refuses an app whose manifest lacks INTERNET — and a sideloaded APK
; cannot be given it afterwards. CHANGE_WIFI_MULTICAST_STATE too: Godot's
; Android runtime takes the Wi-Fi multicast lock (GodotMulticastLock) for a
; socket with broadcast enabled only when it is declared, and without the
; lock the Wi-Fi drops the Game Browser's broadcasts. All four are normal
; permissions: no prompt on the headset. build_release.sh --quest checks
; the built APK asks for them (aapt).
[preset.7]

name="Android Quest"
platform="Android"
runnable=true
advanced_options=false
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter="*.deck, *.txt, cards/data/*.json, packaging/card_packs/*/*.json"
exclude_filter="tests/*, tools/*, docs/*, addons/*, assets/*, sim_results/*, *.md, DeckLab/results/*, workspace/*"
